{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Rankd": "Server=localhost;Database=Rankd;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "MigrateOnStartup": false,
    "SeedCatalogue": true
  },
  "GlobalRanking": {
    "Enabled": true,
    "Interval": "00:15:00"
  },
  "RateLimits": {
    "RequestsPerMinute": 240,
    "WritesPerMinute": 60
  },
  "Cors": {
    "Origins": []
  }
}
