<svg width="@Size" height="@Size" viewBox="0 0 42 42" role="img" aria-label="@Label" style="flex:none">
    <circle cx="21" cy="21" r="15.915" fill="none" stroke="var(--surface-sunk)" stroke-width="5.5" />
    @{
        double offset = 25;
        double total = Math.Max(1, Slices.Sum(s => s.Value));
    }
    @foreach (var s in Slices)
    {
        var pct = s.Value / total * 100;
        <circle cx="21" cy="21" r="15.915" fill="none" stroke="@s.Color" stroke-width="5.5" stroke-linecap="butt"
                stroke-dasharray="@($"{Math.Max(0, pct - 0.8).ToString("0.##", CultureInfo.InvariantCulture)} {(100 - Math.Max(0, pct - 0.8)).ToString("0.##", CultureInfo.InvariantCulture)}")"
                stroke-dashoffset="@offset.ToString("0.##", CultureInfo.InvariantCulture)" />
        offset -= pct;
    }
    @((MarkupString)$"<text x='21' y='20.5' text-anchor='middle' style='font-family:var(--display);font-weight:700;font-size:7.5px;fill:var(--text)'>{System.Net.WebUtility.HtmlEncode(Center)}</text>")
    @((MarkupString)$"<text x='21' y='26.5' text-anchor='middle' style='font-size:3.4px;fill:var(--muted)'>{System.Net.WebUtility.HtmlEncode(Caption)}</text>")
</svg>

@code {
    public sealed record Slice(string Label, double Value, string Color);
    [Parameter] public IReadOnlyList<Slice> Slices { get; set; } = [];
    [Parameter] public string Center { get; set; } = "";
    [Parameter] public string Caption { get; set; } = "";
    [Parameter] public string Label { get; set; } = "Breakdown";
    [Parameter] public int Size { get; set; } = 132;
}
