@* An item's picture, or a monogram on the topic's gradient when it has none. *@
<div class="thumb @Size" style="@(string.IsNullOrEmpty(Url) ? $"background:{Gradient}" : "")">
    @if (!string.IsNullOrEmpty(Url))
    {
        <img src="@Url" alt="" loading="lazy" referrerpolicy="no-referrer" />
    }
    else
    {
        @Monogram
    }
</div>

@code {
    [Parameter] public string? Url { get; set; }
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string Accent { get; set; } = "#7C5CFF";
    [Parameter] public string Size { get; set; } = "";

    private string Monogram
    {
        get
        {
            var words = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Where(w => char.IsLetterOrDigit(w[0])).ToArray();
            return words.Length switch
            {
                0 => Name.Length > 0 ? Name[..Math.Min(2, Name.Length)] : "?",
                1 => words[0][..Math.Min(2, words[0].Length)],
                _ => $"{words[0][0]}{words[^1][0]}",
            };
        }
    }

    private string Gradient => Palette.Gradient(Accent, Name);
}
